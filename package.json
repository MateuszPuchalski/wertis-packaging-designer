{
  "name": "wertis-packaging-designer",
  "version": "0.1.0",
  "private": true,
  "description": "Design WERTIS packaging in the browser: window zip pouches, stand-up pouches and folding boxes, with printer proofs, vector exports and mockups.",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.js",
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "playtest": "node scripts/playtest.js",
    "ci": "npm run lint && npm test && npm run playtest",
    "vendor": "node scripts/vendor.js",
    "import-logo": "node scripts/import-logo.js",
    "import-icons": "node scripts/import-icons.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "cannon-es": "0.20.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jspdf": "4.2.1",
    "jsqr": "1.4.0",
    "opentype.js": "2.0.0",
    "playwright": "1.56.1",
    "qrcode-generator": "2.0.4",
    "svg2pdf.js": "2.8.1",
    "three": "0.186.1"
  }
}
